{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kitchen-cater-no",
  "compatibility_date": "2026-09-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "kitchen-cater.no", "custom_domain": true },
    { "pattern": "www.kitchen-cater.no", "custom_domain": true }
  ]
}
